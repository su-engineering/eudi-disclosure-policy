{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/su-engineering/eudi-disclosure-policy/blob/main/schema/disclosure-policy-v1.schema.json",
  "title": "EUDI disclosure policy, schema version 1.0",
  "description": "A local data-minimization policy for verifier-side preflight of OpenID4VP 1.0 DCQL requests. Structural schema only: validatePolicy() additionally rejects duplicate rule ids and types, contradictory allow and deny rules, a credentialType kind that does not match the format, mso_mdoc path shapes, allowRetention outside mso_mdoc allow rules, and forbidden keys such as __proto__.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyId",
    "policyVersion",
    "purposeId",
    "credentials",
    "defaults"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "policyId": { "$ref": "#/$defs/text" },
    "policyVersion": { "$ref": "#/$defs/text" },
    "purposeId": { "$ref": "#/$defs/text" },
    "description": { "$ref": "#/$defs/text" },
    "credentials": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/credentialRule" }
    },
    "defaults": { "$ref": "#/$defs/defaults" },
    "reviewedExtensions": {
      "type": "array",
      "maxItems": 256,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "path": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "anyOf": [{ "type": "string" }, { "type": "integer", "minimum": 0 }, { "type": "null" }]
      }
    },
    "claimRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "matching"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "matching": { "enum": ["exact", "subtree"] },
        "reason": { "$ref": "#/$defs/text" },
        "classification": { "enum": ["ordinary", "sensitive", "highly-sensitive"] },
        "allowRetention": { "type": "boolean" }
      }
    },
    "denyClaimRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "matching"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "matching": { "enum": ["exact", "subtree"] },
        "reason": { "$ref": "#/$defs/text" },
        "classification": { "enum": ["ordinary", "sensitive", "highly-sensitive"] }
      }
    },
    "credentialRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "format", "credentialType", "allowClaims"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "format": { "$ref": "#/$defs/text" },
        "credentialType": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "enum": ["vct", "doctype"] },
            "value": { "$ref": "#/$defs/text" }
          }
        },
        "allowClaims": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/claimRule" }
        },
        "denyClaims": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/denyClaimRule" }
        },
        "disclosureProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["selective", "non-selective", "mixed", "unknown"] },
            "knownMandatoryPaths": {
              "type": "array",
              "maxItems": 4096,
              "items": { "$ref": "#/$defs/path" }
            },
            "schemaId": { "$ref": "#/$defs/text" },
            "schemaVersion": { "$ref": "#/$defs/text" }
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknownCredential",
        "unknownClaim",
        "unknownDisclosure",
        "registrationEvidenceRequired",
        "permitValueConstraints",
        "permitHolderBindingDisabled",
        "permitMultipleCredentials"
      ],
      "properties": {
        "unknownCredential": { "enum": ["indeterminate", "deny"] },
        "unknownClaim": { "enum": ["indeterminate", "deny"] },
        "unknownDisclosure": { "enum": ["indeterminate", "warn"] },
        "registrationEvidenceRequired": { "type": "boolean" },
        "permitValueConstraints": { "type": "boolean" },
        "permitHolderBindingDisabled": { "type": "boolean" },
        "permitMultipleCredentials": { "type": "boolean" },
        "maxCredentialQueries": { "type": "integer", "minimum": 1 },
        "maxClaimQueries": { "type": "integer", "minimum": 1 },
        "broadSelector": { "enum": ["indeterminate", "deny"] },
        "retentionIntent": { "enum": ["deny", "warn"] },
        "unknownExtension": { "enum": ["indeterminate", "warn"] },
        "invalidRegistrationEvidence": { "enum": ["indeterminate", "deny"] }
      }
    }
  }
}
