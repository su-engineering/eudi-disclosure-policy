{
  "credentials": [
    {
      "id": "age",
      "format": "dc+sd-jwt",
      "meta": {
        "vct_values": ["urn:example:proof-of-age:v1"]
      },
      "claims": [
        {
          "path": ["age_over_18"]
        }
      ]
    },
    {
      "id": "address",
      "format": "dc+sd-jwt",
      "meta": {
        "vct_values": ["urn:example:proof-of-age:v1"]
      },
      "claims": [
        {
          "path": ["resident_address"]
        }
      ]
    }
  ],
  "credential_sets": [
    {
      "required": true,
      "options": [["age"]]
    },
    {
      "required": false,
      "options": [["address"]]
    }
  ]
}
