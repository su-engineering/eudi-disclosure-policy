{
  "id": "TC-PURPOSE-03b",
  "title": "Parent object request with broadSelector deny",
  "reason": "The parent of an allowed child is broader than the allowlist; this policy escalates that to DENY.",
  "standardRefs": [],
  "policy": {
    "schemaVersion": "1.0",
    "policyId": "example.age-gate",
    "policyVersion": "1.0.0",
    "purposeId": "age-verification-over-18",
    "description": "Verify age threshold without collecting identity attributes",
    "credentials": [
      {
        "id": "proof-of-age",
        "format": "dc+sd-jwt",
        "credentialType": {
          "kind": "vct",
          "value": "urn:example:proof-of-age:v1"
        },
        "allowClaims": [
          {
            "path": ["age_over_18"],
            "matching": "exact",
            "classification": "ordinary"
          },
          {
            "path": ["address", "locality"],
            "matching": "exact"
          }
        ],
        "denyClaims": [
          {
            "path": ["birth_date"],
            "matching": "exact",
            "classification": "sensitive"
          },
          {
            "path": ["family_name"],
            "matching": "exact",
            "classification": "sensitive"
          },
          {
            "path": ["resident_address"],
            "matching": "subtree",
            "classification": "sensitive"
          }
        ],
        "disclosureProfile": {
          "mode": "selective",
          "knownMandatoryPaths": [],
          "schemaId": "example:proof-of-age",
          "schemaVersion": "1"
        }
      }
    ],
    "defaults": {
      "unknownCredential": "indeterminate",
      "unknownClaim": "deny",
      "unknownDisclosure": "indeterminate",
      "registrationEvidenceRequired": false,
      "permitValueConstraints": false,
      "permitHolderBindingDisabled": false,
      "permitMultipleCredentials": false,
      "maxCredentialQueries": 32,
      "maxClaimQueries": 256,
      "broadSelector": "deny"
    }
  },
  "evaluationTime": "2026-11-05T16:00:00Z",
  "dcql": {
    "credentials": [
      {
        "id": "age",
        "format": "dc+sd-jwt",
        "meta": {
          "vct_values": ["urn:example:proof-of-age:v1"]
        },
        "claims": [
          {
            "path": ["address"]
          }
        ]
      }
    ]
  },
  "expected": {
    "verdict": "DENY",
    "coverage": "complete",
    "findings": ["DENY BROAD_CLAIM_SELECTOR /credentials/0/claims/0/path"]
  }
}
