  "standardRefs": [],
  "policy": "age-gate",
  "evaluationTime": "2026-11-05T16:00:00Z",
  "dcql": {
    "credentials": [
      {
        "id": "age",
        "format": "dc+sd-jwt",
        "meta": {
          "vct_values": ["urn:example:proof-of-age:v1"]
        },
        "claims": [
          {
            "path": ["age_over_18"],
            "intent_to_retain": true
          }
        ]
      }
    ]
  },
  "expected": {
    "verdict": "INDETERMINATE",
    "coverage": "partial",
