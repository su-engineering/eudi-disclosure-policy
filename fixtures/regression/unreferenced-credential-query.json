{
  "id": "TC-ALT-09",
  "title": "Credential query not referenced by credential_sets",
  "reason": "A credential query outside every option is never requested; its claims are not evaluated as disclosed.",
  "standardRefs": ["OpenID4VP 1.0 §6.4.2"],
  "policy": "age-gate",
  "evaluationTime": "2026-11-05T16:00:00Z",
  "dcql": {
    "credentials": [
      {
        "id": "age",
        "format": "dc+sd-jwt",
        "meta": {
          "vct_values": ["urn:example:proof-of-age:v1"]
        },
        "claims": [
          {
            "path": ["age_over_18"]
          }
        ]
      },
      {
        "id": "unused",
        "format": "dc+sd-jwt",
        "meta": {
          "vct_values": ["urn:example:proof-of-age:v1"]
        },
        "claims": [
          {
            "path": ["birth_date"]
          }
        ]
      }
    ],
    "credential_sets": [
      {
        "options": [["age"]]
      }
    ]
  },
  "expected": {
    "verdict": "ALLOW",
    "coverage": "complete",
    "findings": ["ALLOW UNREFERENCED_QUERY /credentials/1"]
  }
}
