{
  "id": "TC-ALT-04",
  "title": "One option references two credentials",
  "reason": "An option is a conjunction: both credentials are presented together, and one violates the policy.",
  "standardRefs": ["OpenID4VP 1.0 §6.2"],
  "policy": "age-gate",
  "evaluationTime": "2026-11-05T16:00:00Z",
  "dcql": {
    "credentials": [
      {
        "id": "age",
        "format": "dc+sd-jwt",
        "meta": {
          "vct_values": ["urn:example:proof-of-age:v1"]
        },
        "claims": [
          {
            "path": ["age_over_18"]
          }
        ]
      },
      {
        "id": "name",
        "format": "dc+sd-jwt",
        "meta": {
          "vct_values": ["urn:example:proof-of-age:v1"]
        },
        "claims": [
          {
            "path": ["family_name"]
          }
        ]
      }
    ],
    "credential_sets": [
      {
        "options": [["age", "name"]]
      }
    ]
  },
  "expected": {
    "verdict": "DENY",
    "coverage": "complete",
    "findings": ["DENY CLAIM_EXPLICITLY_DENIED /credentials/1/claims/0/path [cs0.o0]"]
  }
}
